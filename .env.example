# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-and-long-random-string-here

# Firebase Web App Configuration
# Get these from your Firebase project settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# Path to the Firebase Admin SDK credentials
# This file should be in the root directory and is gitignored.
FIREBASE_CONFIG_PATH=firebase_config.json